Z","iopub.status.busy":"2026-11-09T17:43:03.728211Z","iopub.status.idle":"2026-11-09T17:43:07.740737Z","shell.execute_reply":"2026-11-09T17:43:07.739657Z"},"papermill":{"duration":4.031195,"end_time":"2026-11-09T17:43:07.742626+00:00","exception":false,"start_time":"2026-11-09T17:43:03.711431+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["torch.Size([32, 3, 224, 224]) torch.Size([32])\n"]}],"source":["BATCH_SIZE = 32\n","\n","train_loader = DataLoader(train_dataset, batch_size=BATCH_SIZE, shuffle=True,  num_workers=2)\n","valid_loader = DataLoader(valid_dataset, batch_size=BATCH_SIZE, shuffle=False, num_workers=2)\n","test_loader  = DataLoader(test_dataset,  batch_size=BATCH_SIZE, shuffle=False, num_workers=2)\n","\n","xb, yb = next(iter(train_loader))\n","print(xb.shape, yb.shape)   # [32, 3, 224, 224] [32]"]},{"cell_type":"markdown","id":"1e88daca","metadata":{"papermill":{"duration":0.015691,"end_time":"2026-11-09T17:43:07.776188+00:00","exception":false,"start_time":"2026-11-09T17:43:07.760497+00:00","status":"completed"},"tags":[]},"source":["## 10. Build the CNN Model"]},{"cell_type":"code","execution_count":10,"id":"7754c29c","metadata":{"execution":{"iopub.execute_input":"2026-11-09T17:43:07.895086Z","iopub.status.busy":"2026-11-09T17:43:07.894651Z","iopub.status.idle":"2026-11-09T17:43:08.256349Z","shell.execute_reply":"2026-11-09T17:43:08.255397Z"},"papermill":{"duration":0.466654,"end_time":"2026-11-09T17:43:08.258081+00:00","exception":false,"start_time":"2026-11-09T17:43:07.791427+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["CNNModel(\n","  (features): Sequential(\n","    (0): Conv2d(3, 32, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n","    (1): BatchNorm2d(32, eps=1e-05, momentum=0.1, affine=True, track_running_stats=True)\n","    (2): ReLU()\n","    (3): MaxPool2d(kernel_size=2, stride=2, padding=0, dilation=1, ceil_mode=False)\n","    (4): Conv2d(32, 64, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n","    (5): BatchNorm2d(64, eps=1e-05, momentum=0.1, affine=True, track_running_stats=True)\n","    (6): ReLU()\n","    (7): MaxPool2d(kernel_size=2, stride=2, padding=0, dilation=1, ceil_mode=False)\n","    (8): Conv2d(64, 128, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n","    (9): BatchNorm2d(128, eps=1e-05, momentum=0.1, affine=True, track_running_stats=True)\n","    (10): ReLU()\n","    (11): MaxPool2d(kernel_size=2, stride=2, padding=0, dilation=1, ceil_mode=False)\n","    (12): Conv2d(128, 256, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n","    (13): BatchNorm2d(256, eps=1e-05, momentum=0.1, affine=True, track_running_stats=True)\n","    (14): ReLU()\n","    (15): MaxPool2d(kernel_size=2, stride=2, padding=0, dilation=1, ceil_mode=False)\n","  )\n","  (classifier): Sequential(\n","    (0): Flatten(start_dim=1, end_dim=-1)\n","    (1): Linear(in_features=50176, out_features=256, bias=True)\n","    (2): ReLU()\n","    (3): Dropout(p=0.5, inplace=False)\n","    (4): Linear(in_features=256, out_features=1, bias=True)\n","  )\n",")\n"]}],"source":["class CNNModel(nn.Module):\n","    def __init__(self):\n","        super().__init__()\n","        self.features = nn.Sequential(\n","            nn.Conv2d(3, 32, kernel_size=3, padding=1),\n","            nn.BatchNorm2d(32), nn.ReLU(), nn.MaxPool2d(2),     # 224 -> 112\n","\n","            nn.Conv2d(32, 64, kernel_size=3, padding=1),\n","            nn.BatchNorm2d(64), nn.ReLU(), nn.MaxPool2d(2),     # 112 -> 56\n","\n","            nn.Conv2d(64, 128, kernel_size=3, padding=1),\n","            nn.BatchNorm2d(128), nn.ReLU(), nn.MaxPool2d(2),    # 56 -> 28\n","\n","            nn.Conv2d(128, 256, kernel_size=3, padding=1),\n","            nn.BatchNorm2d(256), nn.ReLU(), nn.MaxPool2d(2),    # 28 -> 14\n","        )\n","        self.classifier = nn.Sequential(\n","            nn.Flatten(),\n","            nn.Linear(256 * 14 * 14, 256),\n","            nn.ReLU(),\n","            nn.Dropout(0.5),\n","            nn.Linear(256, 1),\n","        )\n","\n","    def forward(self, x):\n","        x = self.features(x)\n","        return self.classifier(x)\n","\n","model = CNNModel().to(device)\n","print(model)"]},{"cell_type":"markdown","id":"1a61eb09","metadata":{"papermill":{"duration":0.015402,"end_time":"2026-11-09T17:43:08.28952+00:00","exception":false,"start_time":"2026-11-09T17:43:08.274118+00:00","status":"completed"},"tags":[]},"source":["## 11. Loss, Optimizer and Scheduler"]},{"cell_type":"code","execution_count":11,"id":"4db0170f","metadata":{"execution":{"iopub.execute_input":"2026-11-09T17:43:08.321519Z","iopub.status.busy":"2026-11-09T17:43:08.321227Z","iopub.status.idle":"2026-11-09T17:43:08.326136Z","shell.execute_reply":"2026-11-09T17:43:08.325368Z"},"papermill":{"duration":0.022925,"end_time":"2026-11-09T17:43:08.327818+00:00","exception":false,"start_time":"2026-11-09T17:43:08.304893+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["PATIENCE = 5\n","LR = 1e-3\n","\n","criterion = nn.BCEWithLogitsLoss()\n","optimizer = optim.Adam(model.parameters(), lr=LR, weight_decay=1e-4)\n","scheduler = optim.lr_scheduler.ReduceLROnPlateau(\n","    optimizer, mode='max', factor=0.5, patience=2, min_lr=1e-6\n",")"]},{"cell_type":"markdown","id":"01a825cd","metadata":{"papermill":{"duration":0.015277,"end_time":"2026-11-09T17:43:08.359517+00:00","exception":false,"start_time":"2026-11-09T17:43:08.34424+00:00","status":"completed"},"tags":[]},"source":["## 12. Train / Validation Function (run_epoch)"]},{"cell_type":"code","execution_count":12,"id":"83b6ed0a","metadata":{"execution":{"iopub.execute_input":"2026-11-09T17:43:08.391949Z","iopub.status.busy":"2026-11-09T17:43:08.391607Z","iopub.status.idle":"2026-11-09T17:43:08.397968Z","shell.execute_reply":"2026-11-09T17:43:08.397367Z"},"papermill":{"duration":0.024616,"end_time":"2026-11-09T17:43:08.399591+00:00","exception":false,"start_time":"2026-11-09T17:43:08.374975+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def run_epoch(loader, train=False):\n","    model.train(train)\n","    total_loss, correct, n = 0.0, 0, 0\n","    all_preds, all_labels = [], []\n","\n","    with torch.set_grad_enabled(train):\n","        for images, labels in loader:\n","            images = images.to(device)\n","            labels = labels.float().unsqueeze(1).to(device)\n","\n","            output = model(images)\n","            loss = criterion(output, labels)\n","\n","            if train:\n","                optimizer.zero_grad()\n","                loss.backward()\n","                optimizer.step()\n","\n","            total_loss += loss.item() * len(labels)\n","            preds = (torch.sigmoid(output) >= 0.5).int()\n","            correct += (preds == labels.int()).sum().item()\n","            n += len(labels)\n","            all_preds.extend(preds.cpu().flatten().tolist())\n","            all_labels.extend(labels.cpu().int().flatten().tolist())\n","\n","    avg_loss = total_loss / n\n","    acc = correct / n\n","    macro_f1 = f1_score(all_labels, all_preds, average=\"macro\")\n","    return avg_loss, acc, macro_f1, all_preds, all_labels"]},{"cell_type":"markdown","id":"97ff8314","metadata":{"papermill":{"duration":0.015896,"end_time":"2026-11-09T17:43:08.430924+00:00","exception":false,"start_time":"2026-11-09T17:43:08.415028+00:00","status":"completed"},"tags":[]},"source":["## 13. Early Stopping Class (keeps the best model)"]},{"cell_type":"code","execution_count":13,"id":"7403daac","metadata":{"execution":{"iopub.execute_input":"2026-11-09T17:43:08.465324Z","iopub.status.busy":"2026-11-09T17:43:08.464609Z","iopub.status.idle":"2026-11-09T17:43:08.471038Z","shell.execute_reply":"2026-11-09T17:43:08.470285Z"},"papermill":{"duration":0.024841,"end_time":"2026-11-09T17:43:08.472493+00:00","exception":false,"start_time":"2026-11-09T17:43:08.447652+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["class EarlyStopping:\n","    def __init__(self, patience=5, min_delta=0.0, mode='max'):\n","        self.patience = patience\n","        self.min_delta = min_delta\n","        self.mode = mode\n","        self.counter = 0\n","        self.best_score = -float('inf') if mode == 'max' else float('inf')\n","        self.best_state = None\n","        self.early_stop = False\n","\n","    def _improved(self, score):\n","        if self.mode == 'max':\n","            return score > self.best_score + self.min_delta\n","        return score < self.best_score - self.min_delta\n","\n","    def __call__(self, score, model):\n","        if self._improved(score):\n","            self.best_score = score\n","            self.best_state = copy.deepcopy(model.state_dict())\n","            self.counter = 0\n","        else:\n","            self.counter += 1\n","            print(f\"EarlyStopping counter: {self.counter} out of {self.patience}\")\n","            if self.counter >= self.patience:\n","                self.early_stop = True"]},{"cell_type":"markdown","id":"312c0801","metadata":{"papermill":{"duration":0.015913,"end_time":"2026-11-09T17:43:08.504206+00:00","exception":false,"start_time":"2026-11-09T17:43:08.488293+00:00","status":"completed"},"tags":[]},"source":["## 14. Train the Model"]},{"cell_type":"code","execution_count":14,"id":"d096091e","metadata":{"execution":{"iopub.execute_input":"2026-11-09T17:43:08.538422Z","iopub.status.busy":"2026-11-09T17:43:08.537563Z","iopub.status.idle":"2026-11-09T18:29:26.670593Z","shell.execute_reply":"2026-11-09T18:29:26.669682Z"},"papermill":{"duration":2778.168819,"end_time":"2026-11-09T18:29:26.68896+00:00","exception":false,"start_time":"2026-11-09T17:43:08.520141+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Epoch 01/30 | Loss 1.0037 Acc 0.5781 F1 0.5670 | Val Loss 0.6258 Val Acc 0.6380 Val F1 0.6351 | LR 0.001000\n","Epoch 02/30 | Loss 0.6270 Acc 0.6331 F1 0