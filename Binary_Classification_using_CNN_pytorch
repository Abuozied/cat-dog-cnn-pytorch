taset), (\"Test\", test_dataset)]:\n","    counts = Counter(ds.targets)\n","    print(name, {class_names[k]: v for k, v in sorted(counts.items())})\n","\n","sns.countplot(x=[class_names[t] for t in train_dataset.targets])\n","plt.title(\"Class Distribution (train)\")\n","plt.show()"]},{"cell_type":"markdown","id":"e5933f99","metadata":{"papermill":{"duration":0.015477,"end_time":"2026-11-09T14:59:21.614388+00:00","exception":false,"start_time":"2026-11-09T14:59:21.598911+00:00","status":"completed"},"tags":[]},"source":["## 8. Check Shape and Augmentation of One Image"]},{"cell_type":"code","execution_count":8,"id":"bcf11a2a","metadata":{"execution":{"iopub.execute_input":"2026-11-09T14:59:21.647567Z","iopub.status.busy":"2026-11-09T14:59:21.647298Z","iopub.status.idle":"2026-11-09T14:59:21.97774Z","shell.execute_reply":"2026-11-09T14:59:21.977053Z"},"papermill":{"duration":0.35164,"end_time":"2026-11-09T14:59:21.981672+00:00","exception":false,"start_time":"2026-11-09T14:59:21.630032+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["torch.Size([3, 224, 224])\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 640x480 with 1 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["image, label = train_dataset[0]\n","print(image.shape)\n","\n","# undo the normalization so the colors display correctly\n","show = (image * torch.tensor(std).view(3, 1, 1) + torch.tensor(mean).view(3, 1, 1)).clamp(0, 1)\n","\n","plt.imshow(show.permute(1, 2, 0))\n","plt.title(class_names[label])\n","plt.axis(\"off\")\n","plt.show()"]},{"cell_type":"markdown","id":"80d2f348","metadata":{"papermill":{"duration":0.018737,"end_time":"2026-11-09T14:59:22.021162+00:00","exception":false,"start_time":"2026-11-09T14:59:22.002425+00:00","status":"completed"},"tags":[]},"source":["## 9. Data Loaders"]},{"cell_type":"code","execution_count":9,"id":"af844e99","metadata":{"execution":{"iopub.execute_input":"2026-11-09T14:59:22.057839Z","iopub.status.busy":"2026-11-09T14:59:22.057148Z","iopub.status.idle":"2026-11-09T14:59:27.431407Z","shell.execute_reply":"2026-11-09T14:59:27.430102Z"},"papermill":{"duration":5.39438,"end_time":"2026-11-09T14:59:27.433273+00:00","exception":false,"start_time":"2026-11-09T14:59:22.038893+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["torch.Size([32, 3, 224, 224]) torch.Size([32])\n"]}],"source":["BATCH_SIZE = 32\n","\n","train_loader = DataLoader(train_dataset, batch_size=BATCH_SIZE, shuffle=True,  num_workers=2)\n","valid_loader = DataLoader(valid_dataset, batch_size=BATCH_SIZE, shuffle=False, num_workers=2)\n","test_loader  = DataLoader(test_dataset,  batch_size=BATCH_SIZE, shuffle=False, num_workers=2)\n","\n","xb, yb = next(iter(train_loader))\n","print(xb.shape, yb.shape)   # [32, 3, 224, 224] [32]"]},{"cell_type":"markdown","id":"0cba4e13","metadata":{"papermill":{"duration":0.016957,"end_time":"2026-11-09T14:59:27.468151+00:00","exception":false,"start_time":"2026-11-09T14:59:27.451194+00:00","status":"completed"},"tags":[]},"source":["## 10. Build the CNN Model"]},{"cell_type":"code","execution_count":10,"id":"6cfcbd9e","metadata":{"execution":{"iopub.execute_input":"2026-11-09T14:59:27.592219Z","iopub.status.busy":"2026-11-09T14:59:27.591924Z","iopub.status.idle":"2026-11-09T14:59:27.996692Z","shell.execute_reply":"2026-11-09T14:59:27.995707Z"},"papermill":{"duration":0.514216,"end_time":"2026-11-09T14:59:27.998415+00:00","exception":false,"start_time":"2026-11-09T14:59:27.484199+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["CNNModel(\n","  (features): Sequential(\n","    (0): Conv2d(3, 32, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n","    (1): BatchNorm2d(32, eps=1e-05, momentum=0.1, affine=True, track_running_stats=True)\n","    (2): ReLU()\n","    (3): MaxPool2d(kernel_size=2, stride=2, padding=0, dilation=1, ceil_mode=False)\n","    (4): Conv2d(32, 64, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n","    (5): BatchNorm2d(64, eps=1e-05, momentum=0.1, affine=True, track_running_stats=True)\n","    (6): ReLU()\n","    (7): MaxPool2d(kernel_size=2, stride=2, padding=0, dilation=1, ceil_mode=False)\n","    (8): Conv2d(64, 128, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n","    (9): BatchNorm2d(128, eps=1e-05, momentum=0.1, affine=True, track_running_stats=True)\n","    (10): ReLU()\n","    (11): MaxPool2d(kernel_size=2, stride=2, padding=0, dilation=1, ceil_mode=False)\n","    (12): Conv2d(128, 256, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))\n","    (13): BatchNorm2d(256, eps=1e-05, momentum=0.1, affine=True, track_running_stats=True)\n","    (14): ReLU()\n","    (15): MaxPool2d(kernel_size=2, stride=2, padding=0, dilation=1, ceil_mode=False)\n","  )\n","  (classifier): Sequential(\n","    (0): Flatten(start_dim=1, end_dim=-1)\n","    (1): Linear(in_features=50176, out_features=256, bias=True)\n","    (2): ReLU()\n","    (3): Dropout(p=0.5, inplace=False)\n","    (4): Linear(in_features=256, out_features=1, bias=True)\n","  )\n",")\n"]}],"source":["class CNNModel(nn.Module):\n","    def __init__(self):\n","        super().__init__()\n","        self.features = nn.Sequential(\n","            nn.Conv2d(3, 32, kernel_size=3, padding=1),\n","            nn.BatchNorm2d(32), nn.ReLU(), nn.MaxPool2d(2),     # 224 -> 112\n","\n","            nn.Conv2d(32, 64, kernel_size=3, padding=1),\n","            nn.BatchNorm2d(64), nn.ReLU(), nn.MaxPool2d(2),     # 112 -> 56\n","\n","            nn.Conv2d(64, 128, kernel_size=3, padding=1),\n","            nn.BatchNorm2d(128), nn.ReLU(), nn.MaxPool2d(2),    # 56 -> 28\n","\n","            nn.Conv2d(128, 256, kernel_size=3, padding=1),\n","            nn.BatchNorm2d(256), nn.ReLU(), nn.MaxPool2d(2),    # 28 -> 14\n","        )\n","        self.classifier = nn.Sequential(\n","            nn.Flatten(),\n","            nn.Linear(256 * 14 * 14, 256),\n","            nn.ReLU(),\n","            nn.Dropout(0.5),\n","            nn.Linear(256, 1),\n","        )\n","\n","    def forward(self, x):\n","        x = self.features(x)\n","        return self.classifier(x)\n","\n","model = CNNModel().to(device)\n","print(model)"]},{"cell_type":"markdown","id":"60181187","metadata":{"papermill":{"duration":0.0157,"end_time":"2026-11-09T14:59:28.03086+00:00","exception":false,"start_time":"2026-11-09T14:59:28.01516+00:00","status":"completed"},"tags":[]},"source":["## 11. Loss, Optimizer and Scheduler"]},{"cell_type":"code","execution_count":11,"id":"544c9f78","metadata":{"execution":{"iopub.execute_input":"2026-11-09T14:59:28.063062Z","iopub.status.busy":"2026-11-09T14:59:28.062319Z","iopub.status.idle":"2026-11-09T14:59:28.067574Z","shell.execute_reply":"2026-11-09T14:59:28.066847Z"},"papermill":{"duration":0.02314,"end_time":"2026-11-09T14:59:28.069233+00:00","exception":false,"start_time":"2026-11-09T14:59:28.046093+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["PATIENCE = 5\n","LR = 1e-3\n","\n","criterion = nn.BCEWithLogitsLoss()\n","optimizer = optim.Adam(model.parameters(), lr=LR, weight_decay=1e-4)\n","scheduler = optim.lr_scheduler.ReduceLROnPlateau(\n","    optimizer, mode='max', factor=0.5, patience=2, min_lr=1e-6\n",")"]},{"cell_type":"markdown","id":"5d55fa20","metadata":{"papermill":{"duration":0.015873,"end_time":"2026-11-09T14:59:28.101323+00:00","exception":false,"start_time":"2026-11-09T14:59:28.08545+00:00","status":"completed"},"tags":[]},"source":["## 12. Train / Validation Function (run_epoch)"]},{"cell_type":"code","execution_count":12,"id":"b9b1822b","metadata":{"execution":{"iopub.execute_input":"2026-11-09T14:59:28.134506Z","iopub.status.busy":"2026-11-09T14:59:28.133747Z","iopub.status.idle":"2026-11-09T14:59:28.140131Z","shell.execute_reply":"2026-11-09T14:59:28.139574Z"},"papermill":{"duration":0.02448,"end_time":"2026-11-09T14:59:28.141518+00:00","exception":false,"start_time":"2026-11-09T14:59:28.117038+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def run_epoch(loader, train=False):\n","    model.train(train)\n","    total_loss, correct, n = 0.0, 0, 0\n","    all_preds, all_labels = [], []\n","\n","    with torch.set_grad_enabled(train):\n","        for images, labels in loader:\n","            images = images.to(device)\n","            labels = labels.float().unsqueeze(1).to(device)\n","\n","            output = model(images)\n","            loss = criterion(output, labels)\n","\n","            if train:\n","                optimizer.zero_grad()\n","                loss.backward()\n","                optimizer.step()\n","\n","            total_loss += loss.item() * len(labels)\n","            preds = (torch.sigmoid(output) >= 0.5).int()\n","            correct += (preds == labels.int()).sum().item()\n","            n += len(labels)\n","            all_preds.extend(preds.cpu().flatten().tolist())\n","            all_labels.extend(labels.cpu().int().flatten().tolist())\n","\n","    avg_loss = total_loss / n\n","    acc = correct / n\n","    macro_f1 = f1_score(all_labels, all_preds, average=\"macro\")\n","    return avg_loss, acc, macro_f1, all_preds, all_labels"]},{"cell_type":"markdown","id":"7f86b595","metadata":{"papermill":{"duration":0.01575,"end_time":"2026-11-09T14:59:28.17349+00:00","exception":false,"start_time":"2026-11-09T14:59:28.15774+00:00","status":"completed"},"tags":[]},"source":["## 13. Early Stopping Class (keeps the best model)"]},{"cell_type":"code","execution_count":13,"id":"b876f528","metadata":{"execution":{"iopub.execute_input":"2026-11-09T14:59:28.206754Z","iopub.status.busy":"2026-11-09T14:59:28.206419Z","iopub.status.idle":"2026-11-09T14:59:28.212611Z","shell.execute_reply":"2026-11-09T14:59:28.211874Z"},"papermill":{"duration":0.024719,"end_time":"2026-11-09T14:59:28.214253+00:00","exception":false,"start_time":"2026-11-09T14:59:28.189534+00:00","status":"completed"},"tags":[]},"outputs":[],"sourc